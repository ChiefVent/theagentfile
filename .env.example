# Agent File environment (copy to `.env` — never commit `.env`)

# xAI Grok — Scout and Quill call https://api.x.ai/v1 when either key is set.
# If both are empty, the CLI uses the mock fallback in scripts/grok-bot/mock.ts.
GROK_API_KEY=
XAI_API_KEY=

# Optional model override (default grok-4)
# GROK_MODEL=grok-4

# Force mock even when a key is present
# GROK_MOCK=1
