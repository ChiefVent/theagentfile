---
import ScoreMark from './ScoreMark.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	category: string;
	score: number;
	pricing?: string;
	variant?: 'grid' | 'list';
}

/** Cards link to the profile page only — they must not require `affiliateUrl` or outbound CTAs. */

const {
	href,
	title,
	description,
	category,
	score,
	pricing,
	variant = 'grid',
} = Astro.props;
---

<a
	href={href}
	data-agent-category={category}
	data-agent-title={title}
	data-agent-description={description}
	class:list={[
		'agent-card group flex h-full flex-col rounded-2xl',
		variant === 'list' ? 'p-6 sm:p-7 lg:p-8' : 'p-6 sm:p-7',
	]}
>
	<div class="flex items-start justify-between gap-4">
		<h3
			class:list={[
				'min-w-0 flex-1 font-serif font-semibold tracking-tight text-ink transition-colors group-hover:text-pine dark:text-cream dark:group-hover:text-pine-bright',
				variant === 'list'
					? 'text-xl leading-snug sm:text-[1.4rem]'
					: 'text-xl leading-snug sm:text-[1.25rem]',
			]}
		>
			{title}
		</h3>
		<ScoreMark score={score} size={variant === 'list' ? 'lg' : 'md'} />
	</div>

	<p class="mt-3">
		<span class="agent-card-category">{category}</span>
	</p>

	<p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-muted sm:text-[0.95rem] dark:text-cream/65">
		{description}
	</p>

	{
		pricing && (
			<p class="mt-auto pt-5">
				<span class="block text-[0.68rem] font-medium uppercase tracking-[0.1em] text-ink-muted dark:text-cream/45">
					Pricing
				</span>
				<span class="mt-1 block text-sm font-medium leading-snug text-ink dark:text-cream/85">
					{pricing}
				</span>
			</p>
		)
	}
</a>
