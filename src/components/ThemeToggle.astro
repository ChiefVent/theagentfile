---
const modes = [
	{ id: 'system', label: 'System' },
	{ id: 'light', label: 'Light' },
	{ id: 'dark', label: 'Dark' },
] as const;
---

<div
	class="inline-flex items-center rounded-full border border-line bg-paper/70 p-0.5 dark:border-night-line dark:bg-night-card"
	role="group"
	aria-label="Color theme"
>
	{
		modes.map((mode) => (
			<button
				type="button"
				data-theme-set={mode.id}
				class="theme-opt inline-flex h-8 items-center gap-1.5 rounded-full px-2.5 text-xs font-medium text-ink-muted transition-colors hover:text-ink dark:text-cream/55 dark:hover:text-cream"
				aria-pressed="false"
			>
				{mode.id === 'system' && (
					<svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<rect x="2" y="3" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4" />
						<path d="M6 13h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
					</svg>
				)}
				{mode.id === 'light' && (
					<svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<circle cx="8" cy="8" r="2.4" stroke="currentColor" stroke-width="1.4" />
						<path
							d="M8 2.2v1.3M8 12.5v1.3M2.2 8h1.3M12.5 8h1.3M3.9 3.9l.9.9M11.2 11.2l.9.9M3.9 12.1l.9-.9M11.2 4.8l.9-.9"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
						/>
					</svg>
				)}
				{mode.id === 'dark' && (
					<svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path
							d="M13 10.2A5.2 5.2 0 1 1 5.8 3 4.2 4.2 0 0 0 13 10.2Z"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linejoin="round"
						/>
					</svg>
				)}
				<span class="hidden md:inline">{mode.label}</span>
			</button>
		))
	}
</div>

<script is:inline>
	(function () {
		var KEY = 'agenthub-theme';
		var root = document.documentElement;

		function preferredDark() {
			return window.matchMedia('(prefers-color-scheme: dark)').matches;
		}

		function currentMode() {
			try {
				return localStorage.getItem(KEY) || 'system';
			} catch {
				return 'system';
			}
		}

		function apply(mode) {
			var dark = mode === 'dark' || (mode !== 'light' && preferredDark());
			root.classList.toggle('dark', dark);
			root.dataset.theme = mode;
			document.querySelectorAll('[data-theme-set]').forEach(function (btn) {
				var active = btn.getAttribute('data-theme-set') === mode;
				btn.setAttribute('aria-pressed', active ? 'true' : 'false');
				btn.classList.toggle('bg-pine', active);
				btn.classList.toggle('text-paper', active);
				btn.classList.toggle('dark:text-paper', active);
				btn.classList.toggle('hover:text-ink', !active);
				btn.classList.toggle('dark:hover:text-cream', !active);
			});
		}

		apply(currentMode());

		document.querySelectorAll('[data-theme-set]').forEach(function (btn) {
			btn.addEventListener('click', function () {
				var mode = btn.getAttribute('data-theme-set') || 'system';
				try {
					localStorage.setItem(KEY, mode);
				} catch {
					/* private mode */
				}
				apply(mode);
			});
		});

		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
			if (currentMode() === 'system') apply('system');
		});
	})();
</script>
