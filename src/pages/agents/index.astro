---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AgentCard from '../../components/AgentCard.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { agentSlug } from '../../lib/slug';
import { siteName } from '../../lib/site';

const allAgents = (await getCollection('agents')).sort((a, b) => {
  if (b.data.score !== a.data.score) return b.data.score - a.data.score;
  return a.data.title.localeCompare(b.data.title);
});

const categoryCounts = allAgents.reduce(
  (acc, agent) => {
    acc[agent.data.category] = (acc[agent.data.category] ?? 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

const categories = [...new Set(allAgents.map((a) => a.data.category))].sort((a, b) =>
  a.localeCompare(b),
);

let activeCategory = Astro.url.searchParams.get('category');
try {
  activeCategory =
    activeCategory ??
    new URL(Astro.request.url, Astro.url).searchParams.get('category');
} catch {
  // Static builds may not include the request search string.
}
---

<Layout title={`All Agents | ${siteName}`} description="Browse all curated AI agents">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-10 max-w-2xl">
      <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-[2.6rem]">All Agents</h1>
      <p class="mt-3 text-lg text-ink-muted dark:text-cream/65">
        {allAgents.length === 0
          ? 'The catalog is empty.'
          : `${allAgents.length} curated autonomous agents, scored and filed by what they actually do.`}
      </p>
    </div>

    {allAgents.length > 0 && (
      <div class="category-filter mb-10">
        <div class="agents-search">
          <label
            for="agents-search"
            class="mb-2 block text-[0.68rem] font-medium uppercase tracking-[0.14em] text-ink-muted dark:text-cream/45"
          >
            Search
          </label>
          <div class="agents-search-field">
            <span class="agents-search-icon" aria-hidden="true">
              <svg class="size-4" viewBox="0 0 16 16" fill="none">
                <circle cx="7" cy="7" r="4.25" stroke="currentColor" stroke-width="1.5" />
                <path d="M10.4 10.4 13.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
            <input
              id="agents-search"
              type="search"
              name="q"
              autocomplete="off"
              enterkeyhint="search"
              spellcheck="false"
              placeholder="Search by name or description"
              aria-controls="agents-grid"
            />
            <button
              type="button"
              id="agents-search-clear"
              class="agents-search-clear"
              hidden
              aria-label="Clear search"
            >
              <svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-6 border-t border-line/80 pt-5 dark:border-night-line">
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="text-[0.68rem] font-medium uppercase tracking-[0.14em] text-ink-muted dark:text-cream/45">
              Filter by category
            </p>
            <p id="agents-count" class="text-sm tabular-nums text-ink-muted dark:text-cream/55" aria-live="polite">
              Showing {allAgents.length} of {allAgents.length}
            </p>
          </div>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter agents by category">
            <a
              href="/agents"
              data-chip="all"
              data-active={!activeCategory ? 'true' : 'false'}
              class="chip"
            >
              All
              <span class="chip-count">{allAgents.length}</span>
            </a>
            {categories.map((cat) => (
              <a
                href={`/agents?category=${encodeURIComponent(cat)}`}
                data-chip={cat}
                data-active={activeCategory === cat ? 'true' : 'false'}
                class="chip"
              >
                {cat}
                <span class="chip-count">{categoryCounts[cat]}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    {allAgents.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-line px-6 py-16 text-center dark:border-night-line">
        <p class="font-serif text-xl font-semibold">No agents yet</p>
        <p class="mx-auto mt-2 max-w-md text-ink-muted dark:text-cream/55">
          Add a markdown file under <code class="text-sm">src/content/agents/</code> to publish a profile.
        </p>
        <a href="/" class="btn-ghost mt-6 inline-flex">Back to home</a>
      </div>
    ) : (
      <>
        <div
          id="agents-empty"
          class="rounded-2xl border border-dashed border-line px-6 py-16 text-center dark:border-night-line"
          hidden
        >
          <p id="agents-empty-title" class="font-serif text-xl font-semibold">No matching agents</p>
          <p id="agents-empty-body" class="mx-auto mt-2 max-w-md text-ink-muted dark:text-cream/55">
            Nothing in the catalog matches that filter. Try another category, or view the full list.
          </p>
          <button type="button" id="agents-clear" class="btn-ghost mt-6 inline-flex">
            Clear filters
          </button>
        </div>
        <div id="agents-grid" class="grid gap-5 sm:gap-6 md:grid-cols-2 lg:gap-7">
          {allAgents.map((agent) => (
            <AgentCard
              href={`/agents/${agentSlug(agent)}`}
              title={agent.data.title}
              description={agent.data.description}
              category={agent.data.category}
              score={agent.data.score}
              pricing={agent.data.pricing}
              variant="list"
            />
          ))}
        </div>
      </>
    )}

    <div class="mt-16 sm:mt-20">
      <NewsletterSignup />
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var searchInput = document.getElementById('agents-search');
    var clearSearch = document.getElementById('agents-search-clear');
    var clearAll = document.getElementById('agents-clear');
    var empty = document.getElementById('agents-empty');
    var emptyTitle = document.getElementById('agents-empty-title');
    var emptyBody = document.getElementById('agents-empty-body');
    var grid = document.getElementById('agents-grid');
    var count = document.getElementById('agents-count');
    var cards = document.querySelectorAll('#agents-grid [data-agent-category]');
    var chips = document.querySelectorAll('[data-chip]');
    var total = cards.length;

    function getCategory() {
      return new URLSearchParams(window.location.search).get('category') || '';
    }

    function getQuery() {
      return searchInput ? searchInput.value.trim().toLowerCase() : '';
    }

    function setCategory(value) {
      var url = new URL(window.location.href);
      if (!value || value === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', value);
      }
      history.pushState({}, '', url.pathname + url.search);
    }

    function apply() {
      var category = getCategory();
      var query = getQuery();

      chips.forEach(function (el) {
        var value = el.getAttribute('data-chip');
        var isActive = category ? value === category : value === 'all';
        el.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) {
          el.setAttribute('aria-current', 'true');
        } else {
          el.removeAttribute('aria-current');
        }
      });

      if (clearSearch) {
        clearSearch.hidden = !query;
      }

      var visible = 0;
      cards.forEach(function (el) {
        var catMatch = !category || el.getAttribute('data-agent-category') === category;
        var title = (el.getAttribute('data-agent-title') || '').toLowerCase();
        var desc = (el.getAttribute('data-agent-description') || '').toLowerCase();
        var textMatch = !query || title.indexOf(query) !== -1 || desc.indexOf(query) !== -1;
        var match = catMatch && textMatch;
        el.hidden = !match;
        if (match) visible += 1;
      });

      if (empty) empty.hidden = visible !== 0;
      if (grid) grid.hidden = visible === 0;
      if (count) {
        count.textContent = 'Showing ' + visible + ' of ' + total;
      }
      if (emptyTitle && emptyBody) {
        if (query && category) {
          emptyTitle.textContent = 'No matching agents';
          emptyBody.textContent =
            'Nothing matches that search in this category. Try a different query or clear the filters.';
        } else if (query) {
          emptyTitle.textContent = 'No matching agents';
          emptyBody.textContent = 'No agents match that search. Try another phrase, or clear the search.';
        } else {
          emptyTitle.textContent = 'No agents in this category';
          emptyBody.textContent =
            'Nothing in the catalog matches that filter. Try another category, or view the full list.';
        }
      }
    }

    chips.forEach(function (el) {
      el.addEventListener('click', function (event) {
        event.preventDefault();
        setCategory(el.getAttribute('data-chip'));
        apply();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', apply);
      searchInput.addEventListener('search', apply);
    }

    if (clearSearch) {
      clearSearch.addEventListener('click', function () {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        apply();
      });
    }

    if (clearAll) {
      clearAll.addEventListener('click', function () {
        if (searchInput) searchInput.value = '';
        setCategory('all');
        apply();
      });
    }

    window.addEventListener('popstate', apply);
    apply();
  })();
</script>
