---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ScoreMark from '../../components/ScoreMark.astro';
import { agentSlug } from '../../lib/slug';
import { siteName } from '../../lib/site';
import { agentVisitLink } from '../../lib/affiliate';

export async function getStaticPaths() {
	const agents = await getCollection('agents');
	return agents.map((agent) => ({
		params: { slug: agentSlug(agent) },
		props: { agent },
	}));
}

interface Props {
  agent: CollectionEntry<'agents'>;
}

const { agent } = Astro.props;
const { Content } = await render(agent);
const published = agent.data.date.toISOString().slice(0, 10);
const website = agent.data.website;
const affiliateUrl = agent.data.affiliateUrl;
const visit = agentVisitLink(website, affiliateUrl);
---

<Layout title={`${agent.data.title} | ${siteName}`} description={agent.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="mb-8 text-sm text-ink-muted dark:text-cream/50">
      <a href="/agents" class="transition-colors hover:text-pine dark:hover:text-pine-bright">All agents</a>
      <span class="mx-1.5 text-line dark:text-night-line" aria-hidden="true">/</span>
      <span class="text-ink/80 dark:text-cream/80">{agentSlug(agent)}</span>
    </p>
    <header class="mb-12 border-b border-line pb-10 dark:border-night-line">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <span class="chip pointer-events-none" data-active="false">
          {agent.data.category}
        </span>
        <ScoreMark score={agent.data.score} size="lg" />
      </div>

      <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-[2.6rem]">
        {agent.data.title}
      </h1>
      <p class="mt-4 text-xl leading-relaxed text-ink-muted dark:text-cream/70">
        {agent.data.description}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <div class="text-ink-muted dark:text-cream/55">
          <span>Pricing</span>
          <span class="ml-1.5 font-medium text-ink dark:text-cream">{agent.data.pricing}</span>
        </div>
        <div class="text-ink-muted dark:text-cream/55">
          <span>Listed</span>
          <span class="ml-1.5 font-medium tabular-nums text-ink dark:text-cream">{published}</span>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={visit.href}
          target="_blank"
          rel={visit.rel}
          class="btn-primary py-2 text-sm"
        >
          Visit website
          <span aria-hidden="true">→</span>
        </a>
        {visit.officialHref && (
          <a
            href={visit.officialHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost text-sm"
          >
            Official website
          </a>
        )}
      </div>
      {affiliateUrl && (
        <p class="mt-3 text-xs text-ink-muted dark:text-cream/45">
          The visit button uses an affiliate link. The official site is linked beside it.
        </p>
      )}
    </header>

    <div class="prose prose-lg prose-agenthub dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</Layout>
